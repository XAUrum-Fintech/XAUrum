VITE_SITE_URL=
VITE_ANALYTICS_ID=
# Optional company identity overrides; the CIN has a built-in default, while the address stays hidden until set.
VITE_COMPANY_CIN=
VITE_COMPANY_ADDRESS=
# Contact us form: the recipient address and its Web3Forms access key (web3forms.com). Without a key the form opens a pre-filled email to VITE_CONTACT_EMAIL.
VITE_CONTACT_EMAIL=
VITE_CONTACT_FORM_KEY=
# Set to false to hide the orob consumer app (card, page and links) until launch.
VITE_SHOW_CONSUMER_APP=
